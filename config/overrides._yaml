
#### 
# Overridden configurations
# Set by environment variable "BLUEPRINT_CONFIG", or by the 'default_config' key, or in code
####   


ekg_local:
  :env: # Overide envivonment variable 
    BAML_LOG: "warn"

  paths:
    data_root : ${oc.env:ONEDRIVE, null}/prj/atos-kg/data
    ekg_data : "${oc.env:ONEDRIVE, null}/KORTEX_EKG/proto/input_data/"
    kg_outputs :  ${oc.env:HOME}/kg_outputs


  llm:
    models:
      default: minimax_3@openrouter
  
  embeddings:
    models:
      default: qwen3_06b@deepinfra

  embeddings_store:
    chroma_simple: &chroma_simple
      backend: Chroma 
      embeddings: bge-small-en@local
      table_name_prefix: embeddings
      config:
        storage: ${paths.data_root}/vector_store  # Updated: was 'chroma_path'
    
    chroma_indexed: 
      backend: Chroma
      embeddings: default
      table_name_prefix: embeddings
      index_document: true
      record_manager: sqlite:///${paths.data_root}/vector_store/test_record_manager.sql
      config:
        storage: ${paths.data_root}/vector_store/
      
    default: *chroma_simple

  cli:
    commands:  
    - genai_tk.cli.commands_core.CoreCommands
    - genai_tk.cli.commands_info.InfoCommands
    - genai_tk.workflow.commands.WorkflowCommands
    - genai_tk.extra.commands_extra.ExtraCommands
    - genai_tk.workflow.rag.commands_rag.RagCommands
    - genai_tk.agents.commands_agents.AgentCommands
    - genai_tk.extra.structured.commands_baml.BamlCommands
    - genai_graph.core.commands_ekg.EkgCommands
    - genai_graph.core.commands_docgraph.DocGraphCommands
    - genai_graph.neo4j_import.commands.Neo4jCommands

  kv_store: 
    default:
      type: LocalFileStore
      path: ${paths.data_root}/kv_store
      
    postgres: 
      type: SQLStore
      path: postgresql://${oc.env:POSTGRES_USER,unknown_user}:${oc.env:POSTGRES_PASSWORD,password}@localhost:5432/ekg

  graph_db:
    kuzu_local: &kuzu_local
      type: kuzu
      path: ${paths.kg_outputs}/default/kuzu/ekg_database.db
    neo4j_local: &neo4j_local
      type: neo4j
      path: neo4j://localhost
      username : tcl
      password: ${oc.env:NEO4_PASSWORD, null}
    default: *kuzu_local

  structured:

    rainbow: &default_baml_client
      baml_client: genai_graph.ekg.baml_client

    default: *default_baml_client


